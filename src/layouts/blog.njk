{% extends "layouts/default.njk" %}

{% block navbar %}
  {% include "components/Navbar/Navbar.njk" %}
{% endblock %}

{% block content %}
  <section class="py-20 px-4 max-w-7xl mx-auto">
    <div class="text-center mb-16">
      <h1 class="text-4xl md:text-5xl font-heading font-extrabold text-gradient mb-4">Blog & Update Terbaru</h1>
      <p class="text-gray-400 max-w-2xl mx-auto">Pelajari wawasan terbaru, tips digital marketing, dan integrasi AI untuk mengembangkan bisnis Anda.</p>
    </div>

    <!-- Blog Posts Grid -->
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
      {% block blog_posts %}{% endblock %}
    </div>
  </section>
{% endblock %}

{% block footer %}
  {% include "components/Footer/Footer.njk" %}
{% endblock %}
