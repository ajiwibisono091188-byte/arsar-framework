{
  "schemaVersion": "1.0.0",
  "frameworkVersion": "2.0.0",
  "compatibleSince": "2.0.0",
  "deprecated": false,
  "title": "Testimonial Schema",
  "description": "Skema testimoni ulasan pelanggan",
  "$type": "object",
  "properties": {
    "name": { "type": "string" },
    "position": { "type": "string" },
    "avatar": { "type": "string" },
    "content": { "type": "string" },
    "rating": { "type": "number", "minimum": 1, "maximum": 5 }
  },
  "required": ["name", "content", "rating"],
  "default": {
    "name": "Budi",
    "position": "CEO",
    "avatar": "/avatar.jpg",
    "content": "Sangat bagus!",
    "rating": 5
  },
  "examples": [
    {
      "name": "Budi",
      "content": "Sangat bagus!",
      "rating": 5
    }
  ]
}
