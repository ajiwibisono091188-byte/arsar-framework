{
  "schemaVersion": "1.0.0",
  "frameworkVersion": "2.0.0",
  "compatibleSince": "2.0.0",
  "deprecated": false,
  "title": "SEO Schema",
  "description": "Skema setelan fallback SEO metadata",
  "$type": "object",
  "properties": {
    "defaultTitle": { "type": "string" },
    "titleTemplate": { "type": "string" },
    "defaultDescription": { "type": "string" },
    "robots": { "type": "string" },
    "charset": { "type": "string" },
    "openGraph": {
      "type": "object",
      "properties": {
        "type": { "type": "string" },
        "locale": { "type": "string" }
      }
    }
  },
  "required": ["defaultTitle", "defaultDescription", "robots"],
  "default": {
    "defaultTitle": "ARSAR Static",
    "titleTemplate": "%s | ARSAR",
    "defaultDescription": "Web super cepat.",
    "robots": "index, follow",
    "charset": "UTF-8"
  },
  "examples": [
    {
      "defaultTitle": "ARSAR Static",
      "defaultDescription": "Web super cepat.",
      "robots": "index, follow"
    }
  ]
}
