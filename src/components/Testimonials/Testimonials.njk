<!-- Testimonials Component -->
<section class="py-20 px-4 max-w-7xl mx-auto scroll-animate">
  <div class="text-center mb-16">
    <h2 class="text-3xl md:text-5xl font-heading font-extrabold text-white mb-4">Apa Kata Klien Kami</h2>
    <p class="text-gray-400 max-w-2xl mx-auto">Cerita sukses dari bisnis yang bertumbuh bersama ARSAR AI Marketing OS.</p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
    {% for item in testimonials %}
      <div class="p-8 rounded-2xl bg-white/5 border border-white/10 flex flex-col justify-between gap-6">
        <div>
          <!-- Star ratings -->
          <div class="flex gap-1 text-amber-400 mb-4">
            {% for i in range(0, item.rating) %}
              <svg class="w-4 h-4 fill-current" viewBox="0 0 20 20">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
              </svg>
            {% endfor %}
          </div>
          
          <p class="text-gray-300 text-sm md:text-base italic leading-relaxed">
            "{{ item.content }}"
          </p>
        </div>

        <div class="flex items-center gap-4">
          <div class="w-12 h-12 rounded-full bg-indigo-950 flex items-center justify-center font-bold text-indigo-400 text-xs border border-indigo-500/20">
            <span>{{ item.name.charAt(0) }}</span>
          </div>
          <div>
            <h4 class="text-sm font-bold text-white">{{ item.name }}</h4>
            <span class="text-xs text-gray-500">{{ item.position }}</span>
          </div>
        </div>
      </div>
    {% endfor %}
  </div>
</section>
