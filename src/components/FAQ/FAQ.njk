<!-- FAQ Component -->
<section class="py-20 px-4 max-w-4xl mx-auto scroll-animate" x-data="faqAccordion">
  <div class="text-center mb-16">
    <h2 class="text-3xl md:text-5xl font-heading font-extrabold text-white mb-4">Pertanyaan yang Sering Diajukan</h2>
    <p class="text-gray-400">Temukan jawaban atas pertanyaan paling umum tentang ARSAR AI Marketing OS.</p>
  </div>

  <div class="flex flex-col gap-4">
    {% for item in faq %}
      <div class="border border-white/10 rounded-2xl bg-white/5 overflow-hidden transition-all duration-300">
        <!-- Question Trigger -->
        <button @click="toggle({{ loop.index0 }})" class="w-full text-left p-6 md:p-8 flex justify-between items-center gap-4 hover:bg-white/5 transition-colors focus:outline-none">
          <span class="font-semibold text-white md:text-lg">{{ item.question }}</span>
          <!-- Icon -->
          <svg class="w-5 h-5 text-indigo-400 transition-transform duration-300" :class="isOpen({{ loop.index0 }}) ? 'rotate-180' : 'rotate-0'" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
          </svg>
        </button>

        <!-- Answer Panel -->
        <div x-show="isOpen({{ loop.index0 }})" 
             x-transition:enter="transition ease-out duration-300"
             x-transition:enter-start="opacity-0 max-h-0"
             x-transition:enter-end="opacity-100 max-h-[500px]"
             x-transition:leave="transition ease-in duration-200"
             x-transition:leave-start="opacity-100 max-h-[500px]"
             x-transition:leave-end="opacity-0 max-h-0"
             class="p-6 md:p-8 pt-0 md:pt-0 border-t border-white/5 text-gray-400 text-sm md:text-base leading-relaxed"
             style="display: none;">
          {{ item.answer }}
        </div>
      </div>
    {% endfor %}
  </div>
</section>
