<!-- Breadcrumb Component -->
<nav class="flex text-xs text-gray-500 py-3" aria-label="Breadcrumb">
  <ol class="inline-flex items-center space-x-1 md:space-x-3">
    <li class="inline-flex items-center">
      <a href="/" class="hover:text-white transition-colors flex items-center gap-1.5">
        <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20"><path d="M10.707 2.293a1 1 0 00-1.414 0l-7 7a1 1 0 001.414 1.414L4 10.414V17a1 1 0 001 1h2a1 1 0 001-1v-2a1 1 0 011-1h2a1 1 0 011 1v2a1 1 0 001 1h2a1 1 0 001-1v-6.586l.293.293a1 1 0 001.414-1.414l-7-7z"/></svg>
        Beranda
      </a>
    </li>
    
    {% for item in breadcrumbs %}
      <li>
        <div class="flex items-center">
          <svg class="w-3 h-3 text-gray-600 mx-1" fill="currentColor" viewBox="0 0 32 32"><path d="M12.969 4.281L11.53 5.72 21.812 16l-10.28 10.281 1.437 1.438L24.687 16z"/></svg>
          {% if loop.last %}
            <span class="ml-1 md:ml-2 font-medium text-gray-300" aria-current="page">{{ item.name }}</span>
          {% else %}
            <a href="{{ item.url }}" class="ml-1 md:ml-2 hover:text-white transition-colors">{{ item.name }}</a>
          {% endif %}
        </div>
      </li>
    {% endfor %}
  </ol>
</nav>
