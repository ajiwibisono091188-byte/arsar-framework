<!-- Services Component -->
<section id="services" class="py-20 px-4 max-w-7xl mx-auto scroll-animate">
  <div class="text-center mb-16">
    <h2 class="text-3xl md:text-5xl font-heading font-extrabold text-white mb-4">Layanan Unggulan Kami</h2>
    <p class="text-gray-400 max-w-2xl mx-auto">Kami menyediakan solusi digital komprehensif berbasis AI untuk mempercepat pertumbuhan bisnis Anda.</p>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
    {% for item in services %}
      <div class="glow-card p-8 rounded-2xl bg-white/5 border border-white/10 flex flex-col justify-between transition-all duration-300">
        <div>
          <!-- Icon placeholder wrapper -->
          <div class="w-12 h-12 bg-indigo-600/10 rounded-xl border border-indigo-500/20 flex items-center justify-center text-indigo-400 mb-6">
            <!-- Icon ID outputted as text badge/shape -->
            <span class="text-xs uppercase font-extrabold">{{ item.icon }}</span>
          </div>
          
          <h3 class="text-2xl font-bold text-white mb-4">{{ item.title }}</h3>
          <p class="text-gray-400 text-sm leading-relaxed mb-6">{{ item.shortDescription }}</p>
          
          <!-- Features bullet -->
          <ul class="flex flex-col gap-2 mb-8">
            {% for feature in item.features %}
              <li class="flex items-center gap-2 text-xs text-gray-300">
                <svg class="w-4 h-4 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/>
                </svg>
                {{ feature }}
              </li>
            {% endfor %}
          </ul>
        </div>

        <a href="/services/{{ item.slug }}" class="w-full text-center py-3 bg-white/5 hover:bg-white/10 text-white text-xs font-semibold rounded-lg border border-white/10 transition-colors">
          Detail Layanan
        </a>
      </div>
    {% endfor %}
  </div>
</section>
