<!-- Navbar Component -->
<header x-data="mobileMenu" class="fixed top-0 left-0 w-full z-50 transition-all duration-300 border-b border-white/5 bg-black/20 backdrop-blur-md">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
    <!-- Logo -->
    <a href="/" class="flex items-center gap-2 font-heading font-bold text-xl text-white">
      <span class="p-2 bg-indigo-600 rounded-lg text-white font-black">A</span>
      <span>ARSAR</span>
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden md:flex items-center gap-8">
      {% for item in navigation.header %}
        <div class="relative group">
          <a href="{{ item.path }}" class="text-sm font-medium text-gray-300 hover:text-white transition-colors duration-200 py-2">
            {{ item.label }}
          </a>
          {% if item.children %}
            <!-- Dropdown -->
            <div class="absolute top-full left-0 mt-2 w-48 rounded-lg bg-gray-900 border border-white/10 p-2 shadow-xl opacity-0 translate-y-2 pointer-events-none group-hover:opacity-100 group-hover:translate-y-0 group-hover:pointer-events-auto transition-all duration-200">
              {% for child in item.children %}
                <a href="{{ child.path }}" class="block px-4 py-2 text-xs text-gray-400 hover:text-white hover:bg-white/5 rounded-md transition-colors">
                  {{ child.label }}
                </a>
              {% endfor %}
            </div>
          {% endif %}
        </div>
      {% endfor %}
    </nav>

    <!-- Right Controls -->
    <div class="hidden md:flex items-center gap-4">
      <!-- Dark/Light Mode Switcher -->
      <button @click="Alpine.store('theme', Alpine.store('theme') === 'dark' ? 'light' : 'dark'); window.toggleTheme();" class="p-2 text-gray-400 hover:text-white rounded-lg hover:bg-white/5 transition-colors">
        <!-- SVG Icons for Theme -->
        <span class="sr-only">Toggle Theme</span>
        <svg class="w-5 h-5 block dark:hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 9h-1m15.364-3.364l-.707.707M6.343 17.657l-.707.707m0-12.728l.707.707m12.728 12.728l.707.707M12 8a4 4 0 100 8 4 4 0 000-8z"/></svg>
        <svg class="w-5 h-5 hidden dark:block" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/></svg>
      </button>
      
      <!-- CTA Button -->
      <a href="/contact" class="px-5 py-2.5 bg-indigo-600 hover:bg-indigo-500 text-white text-sm font-semibold rounded-lg shadow-lg hover:shadow-indigo-500/20 transition-all duration-200">
        Mulai Sekarang
      </a>
    </div>

    <!-- Mobile Hamburg Menu -->
    <button @click="toggle()" class="md:hidden p-2 text-gray-400 hover:text-white focus:outline-none">
      <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path x-show="!isOpen" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
        <path x-show="isOpen" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" style="display: none;"/>
      </svg>
    </button>
  </div>

  <!-- Mobile Drawer -->
  <div x-show="isOpen" 
       x-transition:enter="transition ease-out duration-300"
       x-transition:enter-start="opacity-0 -translate-y-4"
       x-transition:enter-end="opacity-100 translate-y-0"
       x-transition:leave="transition ease-in duration-200"
       x-transition:leave-start="opacity-100 translate-y-0"
       x-transition:leave-end="opacity-0 -translate-y-4"
       class="md:hidden absolute top-full left-0 w-full bg-gray-950 border-b border-white/10 p-6 flex flex-col gap-4 shadow-xl"
       style="display: none;">
    <nav class="flex flex-col gap-4">
      {% for item in navigation.header %}
        <a href="{{ item.path }}" @click="close()" class="text-base font-medium text-gray-300 hover:text-white">{{ item.label }}</a>
        {% if item.children %}
          <div class="pl-4 flex flex-col gap-2 border-l border-white/10">
            {% for child in item.children %}
              <a href="{{ child.path }}" @click="close()" class="text-sm text-gray-400 hover:text-white">{{ child.label }}</a>
            {% endfor %}
          </div>
        {% endif %}
      {% endfor %}
    </nav>
    <div class="h-[1px] bg-white/5 my-2"></div>
    <a href="/contact" @click="close()" class="w-full py-3 bg-indigo-600 hover:bg-indigo-500 text-white text-center font-semibold rounded-lg shadow-lg">
      Mulai Sekarang
    </a>
  </div>
</header>
