{% macro Input(name, label="", type="text", value="", placeholder="", required=false, options=null, error=null, id=null, customClass="") %}
  {% set inputId = id or "input-" + name %}
  
  <!-- Base styling mapped to spacing, radius, and colors tokens -->
  {% set baseInputStyle = "w-full bg-white/5 border border-white/10 rounded-[var(--radius-md)] px-4 py-3 text-[var(--font-size-body)] text-white placeholder-gray-500 transition-all duration-[var(--animation-duration-fast)] focus:outline-none focus:border-[var(--color-primary-500)] focus:ring-2 focus:ring-[var(--color-primary-500)]/20" %}
  {% if error %}
    {% set baseInputStyle = baseInputStyle + " border-[var(--color-danger-text)] focus:border-[var(--color-danger-text)] focus:ring-[var(--color-danger-text)]/20" %}
  {% endif %}

  <div class="flex flex-col gap-2 {{ customClass }}">
    
    <!-- 1. CHECKBOX / RADIO / TOGGLE INVERTED LABEL LAYOUT -->
    {% if type == "checkbox" %}
      <label class="inline-flex items-center gap-3 cursor-pointer text-[var(--font-size-body)] text-gray-300">
        <input 
          type="checkbox" 
          id="{{ inputId }}" 
          name="{{ name }}" 
          {% if required %}required{% endif %}
          {% if value == "checked" %}checked{% endif %}
          class="w-5 h-5 rounded-[var(--radius-sm)] bg-white/5 border border-white/10 text-[var(--color-primary-600)] focus:ring-[var(--color-primary-500)]/20 focus:ring-2"
        >
        <span>{{ label }}</span>
      </label>

    {% elif type == "radio" %}
      <label class="inline-flex items-center gap-3 cursor-pointer text-[var(--font-size-body)] text-gray-300">
        <input 
          type="radio" 
          id="{{ inputId }}" 
          name="{{ name }}" 
          value="{{ value }}"
          {% if required %}required{% endif %}
          class="w-5 h-5 rounded-full bg-white/5 border border-white/10 text-[var(--color-primary-600)] focus:ring-[var(--color-primary-500)]/20 focus:ring-2"
        >
        <span>{{ label }}</span>
      </label>

    {% elif type == "toggle" %}
      <label class="inline-flex items-center gap-3 cursor-pointer text-[var(--font-size-body)] text-gray-300" x-data="{ checked: false }">
        <div class="relative">
          <input 
            type="checkbox" 
            id="{{ inputId }}" 
            name="{{ name }}" 
            class="sr-only" 
            x-model="checked"
            {% if required %}required{% endif %}
          >
          <!-- Line bar -->
          <div class="w-10 h-6 bg-white/10 rounded-full transition-colors" :class="checked ? 'bg-[var(--color-primary-600)]' : 'bg-white/10'"></div>
          <!-- Circle dot -->
          <div class="absolute left-1 top-1 w-4 h-4 bg-white rounded-full transition-transform" :class="checked ? 'translate-x-4' : 'translate-x-0'"></div>
        </div>
        <span>{{ label }}</span>
      </label>

    <!-- 2. STANDARD LABELED INPUT LAYOUTS -->
    {% else %}
      {% if label %}
        <label for="{{ inputId }}" class="block text-xs font-semibold text-gray-400 uppercase tracking-wider">
          {{ label }}{% if required %}<span class="text-[var(--color-danger-text)] ml-1">*</span>{% endif %}
        </label>
      {% endif %}

      <!-- TEXTAREA -->
      {% if type == "textarea" %}
        <textarea 
          id="{{ inputId }}" 
          name="{{ name }}" 
          rows="4"
          placeholder="{{ placeholder }}"
          {% if required %}required{% endif %}
          class="{{ baseInputStyle }}"
        >{{ value }}</textarea>

      <!-- SELECT -->
      {% elif type == "select" %}
        <div class="relative">
          <select 
            id="{{ inputId }}" 
            name="{{ name }}" 
            {% if required %}required{% endif %}
            class="{{ baseInputStyle }} appearance-none"
          >
            {% if placeholder %}
              <option value="" disabled selected>{{ placeholder }}</option>
            {% endif %}
            {% for opt in options %}
              <option value="{{ opt.value }}" {% if opt.value == value %}selected{% endif %}>{{ opt.label }}</option>
            {% endfor %}
          </select>
          <!-- Down icon -->
          <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-4 text-gray-400">
            <svg class="fill-current h-4 w-4" viewBox="0 0 20 20"><path d="M9.293 12.95l.707.707L15.657 8l-1.414-1.414L10 10.828 5.757 6.586 4.343 8z"/></svg>
          </div>
        </div>

      <!-- TEXT / EMAIL / NUMBER / PHONE -->
      {% else %}
        <input 
          type="{{ type }}" 
          id="{{ inputId }}" 
          name="{{ name }}" 
          value="{{ value }}"
          placeholder="{{ placeholder }}"
          {% if required %}required{% endif %}
          class="{{ baseInputStyle }}"
        >
      {% endif %}

      <!-- Error Message block -->
      {% if error %}
        <span class="text-xs text-[var(--color-danger-text)] mt-1 flex items-center gap-1">
          <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/></svg>
          {{ error }}
        </span>
      {% endif %}
    {% endif %}

  </div>
{% endmacro %}
