{% macro Card(variant="service", title="", description="", image=null, price=null, features=null, rating=null, author=null, category=null, tag=null, customClass="") %}
  <!-- Base card styling utilizing design tokens -->
  {% set baseClass = "rounded-[var(--radius-xl)] border transition-[var(--transition-property-all)] duration-[var(--animation-duration-normal)] text-[var(--color-dark-text)] overflow-hidden" %}

  {% set variantClass = "" %}
  {% if variant == "glass" %}
    {% set variantClass = "bg-white/[var(--opacity-glass)] backdrop-blur-md border-white/[var(--opacity-glassBorder)] shadow-[var(--shadow-xl)] hover:shadow-indigo-500/10 hover:border-indigo-500/30" %}
  {% else %}
    <!-- Default Dark/Light Surface Card -->
    {% set variantClass = "bg-[var(--color-dark-surface)] border-[var(--color-dark-border)] shadow-[var(--shadow-md)] hover:shadow-[var(--shadow-xl)] hover:border-indigo-500/20" %}
  {% endif %}

  <div class="{{ baseClass }} {{ variantClass }} {{ customClass }}">
    <!-- 1. IMAGE CARD OR BLOG CARD IMAGE -->
    {% if (variant == "image" or variant == "blog") and image %}
      <div class="relative w-full aspect-video overflow-hidden">
        <img src="{{ image }}" alt="{{ title }}" class="w-full h-full object-cover transition-transform duration-[var(--animation-duration-slow)] hover:scale-105">
        {% if tag %}
          <span class="absolute top-4 left-4 px-2.5 py-1 text-[var(--font-size-caption)] font-bold uppercase tracking-wider bg-[var(--color-primary-600)] text-white rounded-[var(--radius-sm)]">
            {{ tag }}
          </span>
        {% endif %}
      </div>
    {% endif %}

    <div class="p-[var(--spacing-lg)] flex flex-col gap-[var(--spacing-md)]">
      <!-- 2. SERVICE CARD -->
      {% if variant == "service" %}
        <div class="w-12 h-12 rounded-[var(--radius-lg)] bg-[var(--color-primary-600)]/10 border border-[var(--color-primary-600)]/20 flex items-center justify-center text-[var(--color-primary-400)] mb-2">
          <span class="font-extrabold text-sm uppercase">SRV</span>
        </div>
        <h3 class="text-[var(--font-size-h3)] font-heading font-bold text-white">{{ title }}</h3>
        <p class="text-[var(--font-size-small)] text-[var(--color-dark-textMuted)] leading-relaxed">{{ description }}</p>
        {% if features %}
          <ul class="flex flex-col gap-2 mt-2">
            {% for feature in features %}
              <li class="flex items-center gap-2 text-[var(--font-size-caption)] text-[var(--color-dark-text)]">
                <svg class="w-4 h-4 text-[var(--color-secondary-500)]" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
                {{ feature }}
              </li>
            {% endfor %}
          </ul>
        {% endif %}

      <!-- 3. BLOG CARD -->
      {% elif variant == "blog" %}
        {% if category %}
          <span class="text-[var(--font-size-caption)] font-semibold text-[var(--color-primary-400)] uppercase tracking-wider">{{ category }}</span>
        {% endif %}
        <h3 class="text-[var(--font-size-h4)] font-heading font-bold text-white leading-snug hover:text-[var(--color-primary-400)] transition-colors">
          <a href="#">{{ title }}</a>
        </h3>
        <p class="text-[var(--font-size-small)] text-[var(--color-dark-textMuted)] leading-relaxed">{{ description }}</p>
        {% if author %}
          <div class="flex items-center gap-3 mt-4 pt-4 border-t border-[var(--color-dark-border)]">
            <div class="w-8 h-8 rounded-full bg-indigo-950 flex items-center justify-center font-bold text-indigo-400 text-xs">
              {{ author.charAt(0) }}
            </div>
            <span class="text-xs font-semibold text-gray-300">{{ author }}</span>
          </div>
        {% endif %}

      <!-- 4. PRICING CARD -->
      {% elif variant == "pricing" %}
        <h3 class="text-[var(--font-size-h3)] font-heading font-bold text-white">{{ title }}</h3>
        {% if price %}
          <div class="my-4">
            <span class="text-[var(--font-size-displayMd)] font-heading font-black text-white">{{ price }}</span>
            <span class="text-xs text-[var(--color-dark-textMuted)]">/ bulan</span>
          </div>
        {% endif %}
        <p class="text-[var(--font-size-small)] text-[var(--color-dark-textMuted)] mb-4">{{ description }}</p>
        {% if features %}
          <ul class="flex flex-col gap-3 my-6 border-t border-[var(--color-dark-border)] pt-6">
            {% for feature in features %}
              <li class="flex items-center gap-2 text-sm">
                <svg class="w-4 h-4 text-[var(--color-secondary-500)]" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
                <span class="text-gray-300">{{ feature }}</span>
              </li>
            {% endfor %}
          </ul>
        {% endif %}

      <!-- 5. REVIEW CARD -->
      {% elif variant == "review" %}
        {% if rating %}
          <div class="flex gap-1 text-amber-400 mb-2">
            {% for i in range(0, rating) %}
              <svg class="w-4 h-4 fill-current" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
            {% endfor %}
          </div>
        {% endif %}
        <p class="text-[var(--font-size-body)] text-gray-300 italic leading-relaxed">"{{ description }}"</p>
        {% if author %}
          <div class="flex items-center gap-3 mt-6">
            <div class="w-10 h-10 rounded-full bg-indigo-950 flex items-center justify-center font-bold text-indigo-400 text-xs">
              {{ author.charAt(0) }}
            </div>
            <h4 class="text-sm font-bold text-white">{{ author }}</h4>
          </div>
        {% endif %}

      <!-- 6. FEATURE CARD -->
      {% elif variant == "feature" %}
        <div class="flex items-start gap-4">
          <div class="w-10 h-10 shrink-0 rounded-[var(--radius-md)] bg-[var(--color-primary-600)]/10 flex items-center justify-center text-[var(--color-primary-400)]">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
          </div>
          <div>
            <h3 class="text-[var(--font-size-h4)] font-heading font-bold text-white mb-2">{{ title }}</h3>
            <p class="text-[var(--font-size-small)] text-[var(--color-dark-textMuted)] leading-relaxed">{{ description }}</p>
          </div>
        </div>

      <!-- 7. DEFAULT IMAGE / GLASS CARD CONTENT -->
      {% else %}
        <h3 class="text-[var(--font-size-h3)] font-heading font-bold text-white">{{ title }}</h3>
        <p class="text-[var(--font-size-body)] text-[var(--color-dark-textMuted)] leading-relaxed">{{ description }}</p>
      {% endif %}
    </div>
  </div>
{% endmacro %}
