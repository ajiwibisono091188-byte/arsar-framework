{% macro Loading(variant="spinner", size="medium", customClass="") %}
  {% set sizeClass = "" %}
  {% if size == "small" %}
    {% set sizeClass = "w-6 h-6" %}
  {% elif size == "large" %}
    {% set sizeClass = "w-12 h-12" %}
  {% else %}
    {% set sizeClass = "w-8 h-8" %}
  {% endif %}

  <div class="inline-flex items-center justify-center {{ customClass }}">
    
    <!-- 1. SPINNER VARIANT -->
    {% if variant == "spinner" %}
      <svg class="animate-spin text-[var(--color-primary-500)] {{ sizeClass }}" fill="none" viewBox="0 0 24 24">
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
      </svg>

    <!-- 2. DOTS VARIANT -->
    {% elif variant == "dots" %}
      <div class="flex gap-1.5 items-center">
        <!-- 3 dots animating using bounce slow -->
        <span class="w-2.5 h-2.5 bg-[var(--color-primary-500)] rounded-full animate-bounce" style="animation-delay: 0.1s;"></span>
        <span class="w-2.5 h-2.5 bg-[var(--color-primary-500)] rounded-full animate-bounce" style="animation-delay: 0.2s;"></span>
        <span class="w-2.5 h-2.5 bg-[var(--color-primary-500)] rounded-full animate-bounce" style="animation-delay: 0.3s;"></span>
      </div>

    <!-- 3. SKELETON PLACEHOLDER -->
    {% elif variant == "skeleton" %}
      <div class="w-full bg-white/5 rounded-[var(--radius-md)] animate-pulse border border-white/5 flex flex-col gap-3 p-4">
        <!-- Line 1 -->
        <div class="h-4 bg-white/10 rounded-[var(--radius-sm)] w-1/3"></div>
        <!-- Line 2 -->
        <div class="h-3 bg-white/10 rounded-[var(--radius-sm)] w-full"></div>
        <!-- Line 3 -->
        <div class="h-3 bg-white/10 rounded-[var(--radius-sm)] w-5/6"></div>
      </div>
    {% endif %}

  </div>
{% endmacro %}
