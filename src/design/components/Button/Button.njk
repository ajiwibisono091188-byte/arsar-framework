{% macro Button(label, variant="primary", size="medium", disabled=false, loading=false, fullWidth=false, icon=null, id=null, type="button", customClass="") %}
  <!-- Size classes mapped to spacing and radius tokens -->
  {% set sizeClass = "" %}
  {% if size == "small" %}
    {% set sizeClass = "px-3 py-1.5 text-[var(--font-size-small)] rounded-[var(--radius-sm)]" %}
  {% elif size == "large" %}
    {% set sizeClass = "px-6 py-3.5 text-[var(--font-size-h5)] rounded-[var(--radius-lg)]" %}
  {% else %}
    {% set sizeClass = "px-5 py-2.5 text-[var(--font-size-body)] rounded-[var(--radius-md)]" %}
  {% endif %}

  <!-- Variant classes mapped to color and opacity tokens -->
  {% set variantClass = "" %}
  {% if disabled %}
    {% set variantClass = "bg-gray-800 text-gray-500 border border-transparent cursor-not-allowed opacity-[var(--opacity-disabled)]" %}
  {% elif variant == "primary" %}
    {% set variantClass = "bg-[var(--color-primary-600)] hover:bg-[var(--color-primary-500)] active:bg-[var(--color-primary-700)] text-white border border-transparent focus:ring-2 focus:ring-[var(--color-primary-300)]" %}
  {% elif variant == "secondary" %}
    {% set variantClass = "bg-[var(--color-secondary-600)] hover:bg-[var(--color-secondary-500)] active:bg-[var(--color-secondary-700)] text-white border border-transparent focus:ring-2 focus:ring-[var(--color-secondary-300)]" %}
  {% elif variant == "outline" %}
    {% set variantClass = "bg-transparent hover:bg-white/5 text-[var(--color-primary-400)] border border-[var(--color-primary-600)] focus:ring-2 focus:ring-[var(--color-primary-300)]" %}
  {% elif variant == "ghost" %}
    {% set variantClass = "bg-transparent hover:bg-white/5 text-[var(--color-dark-text)] border border-transparent focus:ring-2 focus:ring-[var(--color-dark-border)]" %}
  {% elif variant == "success" %}
    {% set variantClass = "bg-[var(--color-success-text)] hover:opacity-[var(--opacity-hover)] text-white border border-transparent focus:ring-2 focus:ring-[var(--color-success-border)]" %}
  {% elif variant == "danger" %}
    {% set variantClass = "bg-[var(--color-danger-text)] hover:opacity-[var(--opacity-hover)] text-white border border-transparent focus:ring-2 focus:ring-[var(--color-danger-border)]" %}
  {% elif variant == "warning" %}
    {% set variantClass = "bg-[var(--color-warning-text)] hover:opacity-[var(--opacity-hover)] text-white border border-transparent focus:ring-2 focus:ring-[var(--color-warning-border)]" %}
  {% endif %}

  <!-- Display & Width classes -->
  {% set widthClass = "w-full flex justify-center" if fullWidth else "inline-flex" %}
  
  <button 
    {% if id %}id="{{ id }}"{% endif %}
    type="{{ type }}"
    class="items-center justify-center font-semibold transition-[var(--transition-property-colors)] duration-[var(--animation-duration-fast)] focus:outline-none select-none {{ sizeClass }} {{ variantClass }} {{ widthClass }} {{ customClass }}"
    {% if disabled or loading %}disabled aria-disabled="true"{% endif %}
    {% if loading %}aria-busy="true"{% endif %}
  >
    {% if loading %}
      <!-- Loading spinner -->
      <svg class="animate-spin -ml-1 mr-2 h-4 w-4 text-current" fill="none" viewBox="0 0 24 24">
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
      </svg>
      Loading...
    {% else %}
      {% if icon %}
        <span class="mr-2 flex items-center justify-center">{{ icon | safe }}</span>
      {% endif %}
      <span>{{ label }}</span>
    {% endif %}
  </button>
{% endmacro %}
