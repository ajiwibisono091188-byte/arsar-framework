{% macro IconWrapper(variant="square", size="medium", customClass="") %}
  {% set sizeClass = "" %}
  {% if size == "small" %}
    {% set sizeClass = "w-8 h-8 text-sm" %}
  {% elif size == "large" %}
    {% set sizeClass = "w-14 h-14 text-lg" %}
  {% else %}
    {% set sizeClass = "w-11 h-11 text-base" %}
  {% endif %}

  <!-- Shape borders and backgrounds mapped to design tokens -->
  {% set variantClass = "" %}
  {% if variant == "circle" %}
    {% set variantClass = "rounded-full bg-[var(--color-primary-600)]/10 border border-[var(--color-primary-600)]/20 text-[var(--color-primary-400)]" %}
  {% elif variant == "glass" %}
    {% set variantClass = "rounded-[var(--radius-md)] bg-white/[var(--opacity-glass)] border border-white/[var(--opacity-glassBorder)] backdrop-blur-md text-white shadow-[var(--shadow-sm)]" %}
  {% else %}
    <!-- Default Square -->
    {% set variantClass = "rounded-[var(--radius-md)] bg-[var(--color-primary-600)]/10 border border-[var(--color-primary-600)]/20 text-[var(--color-primary-400)]" %}
  {% endif %}

  <div class="inline-flex items-center justify-center shrink-0 {{ sizeClass }} {{ variantClass }} {{ customClass }}">
    {{ caller() }}
  </div>
{% endmacro %}
